{
  "name": "metalsmith-sectioned-blog-pagination",
  "version": "2.0.0",
  "description": "Metalsmith plugin that generates paginated blog landing pages from a main blog template",
  "keywords": [
    "metalsmith-blog-pagination",
    "metalsmith-plugin",
    "metalsmith",
    "static-site",
    "pagination"
  ],
  "type": "module",
  "exports": "./src/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wernerglinka/metalsmith-sectioned-blog-pagination.git"
  },
  "files": [
    "src/**/*.js",
    "README.md",
    "LICENSE"
  ],
  "author": "Werner Glinka (https://glinka.co)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/wernerglinka/metalsmith-sectioned-blog-pagination/issues"
  },
  "homepage": "https://github.com/wernerglinka/metalsmith-sectioned-blog-pagination#readme",
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@metalsmith/collections": "^2.0.0",
    "auto-changelog": "^2.5.0",
    "depcheck": "^1.4.7",
    "metalsmith": "^2.5.1",
    "release-it": "^21.0.1"
  },
  "scripts": {
    "audit": "npm audit",
    "changelog": "auto-changelog -u --commit-limit false --ignore-commit-pattern '^((dev|chore|ci):|Release)'",
    "depcheck": "depcheck",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome check --write .",
    "lint:check": "biome check .",
    "pre-release": "npm run lint:check && npm run format:check && npm test && npx metalsmith-plugin-mcp-server validate .",
    "release:check": "npm run lint:check && release-it --dry-run",
    "release:patch": "./scripts/release.sh patch --ci",
    "release:minor": "./scripts/release.sh minor --ci",
    "release:major": "./scripts/release.sh major --ci",
    "test": "node --test --test-timeout=15000 'test/**/*.test.js'",
    "coverage": "mkdir -p coverage && node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info --test-timeout=15000 'test/**/*.test.js'",
    "test:coverage": "npm run coverage"
  },
  "engines": {
    "node": ">= 22.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
